# Railway API service. Railway also injects PORT; do not override it.

SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/DATABASE?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# At least 32 characters. Changing this invalidates existing JWTs.
ACME_JWT_SECRET=

# true on first boot to seed demo users + employees, then set false and redeploy.
ACME_SEED_ENABLED=true

# Comma-separated extra browser origins. https://*.vercel.app is already allowed.
# ACME_CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# ACME_CORS_ORIGIN_PATTERNS=https://*.vercel.app
